// Prisma Schema for AgencyFlow CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  persona       String   @default("AGENCY") // AGENCY, FREELANCER
  niche         String?
  targetRevenue String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Org Identity Settings
  logoUrl         String?
  website         String?
  industry        String?
  companySize     String? // "1-5", "6-20", "21-50", "50+"
  businessEmail   String?
  businessPhone   String?
  businessAddress String?

  // Regional Preferences
  timezone             String @default("UTC")
  language             String @default("en")
  dateFormat           String @default("YYYY-MM-DD")
  timeFormat           String @default("24h") // "12h" | "24h"
  currency             String @default("USD")
  additionalCurrencies Json?  // string[]
  numberFormat         String @default("standard") // "standard" | "european"
  firstDayOfWeek       Int    @default(1) // 0 = Sunday, 1 = Monday

  // Business Calendar
  workingDays       Json?  // number[] e.g. [1,2,3,4,5]
  workingHoursStart String @default("09:00")
  workingHoursEnd   String @default("17:00")
  holidays          Json?  // { date: string, name: string }[]

  // Fiscal Settings
  fiscalYearStartMonth Int    @default(1) // 1-12
  fiscalYearType       String @default("standard") // "standard" | "custom"

  // Workspace Security Policies
  minPasswordLength      Int     @default(8)
  requirePasswordNumbers Boolean @default(true)
  requirePasswordSymbols Boolean @default(false)
  sessionDurationMinutes Int     @default(10080) // 7 days in minutes
  maxConcurrentSessions  Int     @default(5)
  require2FAForAll       Boolean @default(false)

  // Data Visibility Rules: ALL | ASSIGNED_ONLY | TEAM
  leadVisibility    String @default("ALL")
  contactVisibility String @default("ALL")
  dealVisibility    String @default("ALL")
  taskVisibility    String @default("ALL")

  // Phase 3: CRM Configuration & Defaults
  leadSources             Json?   // string[]
  leadStatuses            Json?   // { key: string, label: string, color: string }[]
  defaultLeadOwnerId      String?
  leadAssignmentRule      String  @default("MANUAL") // MANUAL | ROUND_ROBIN | DEFAULT_OWNER
  duplicateLeadDetection  String  @default("EMAIL_AND_PHONE") // OFF | EMAIL_ONLY | EMAIL_AND_PHONE
  dealLossReasons         Json?   // string[]
  dealRequiredFields      Json?   // string[]

  users             User[]
  invitations       Invitation[]
  leads             Lead[]
  companies         Company[]
  contacts          Contact[]
  deals             Deal[]
  activities        Activity[]
  tasks             Task[]
  projects          Project[]
  deliverables      Deliverable[]
  invoices          Invoice[]
  proposals         Proposal[]
  files             FileRecord[]
  leadAiAnalyses    LeadAiAnalysis[]
  outreachEmails    OutreachEmail[]
  auditLogs         AuditLog[]
  pipelines         Pipeline[]
  pipelineStages    PipelineStage[]
  customFields      CustomField[]
  customFieldValues CustomFieldValue[]
}

model User {
  id           String   @id @default(uuid())
  workspaceId  String
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("SALES_REP") // OWNER, ADMIN, MANAGER, SALES_REP, MARKETING, VIEWER
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  avatarUrl    String?
  phone        String?
  jobTitle     String?
  createdAt    DateTime @default(now())

  // Security & 2FA
  twoFactorEnabled  Boolean @default(false)
  twoFactorSecret   String?
  customPermissions Json?

  // Personal Regional Overrides (null/false = inherit Workspace default)
  usePersonalPreferences Boolean @default(false)
  personalTimezone       String?
  personalDateFormat     String?
  personalTimeFormat     String?

  // Interface Preferences
  defaultLandingPage String  @default("/dashboard")
  defaultCrmView     String  @default("kanban") // "kanban" | "table"
  rememberFilters    Boolean @default(true)
  sidebarCollapsed   Boolean @default(false)

  // Appearance & Accessibility
  theme         String  @default("dark") // "system" | "dark" | "light"
  density       String  @default("comfortable") // "comfortable" | "compact"
  reducedMotion Boolean @default(false)
  textSize      String  @default("normal") // "normal" | "large"
  highContrast  Boolean @default(false)

  // Granular Notification Preferences
  notifyEmailDeals     Boolean @default(true)
  notifyEmailTasks     Boolean @default(true)
  notifyEmailProposals Boolean @default(true)
  notifyEmailInvoices  Boolean @default(true)
  notifyInAppDeals     Boolean @default(true)
  notifyInAppTasks     Boolean @default(true)
  notifyInAppProposals Boolean @default(true)
  notifyInAppInvoices  Boolean @default(true)

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions        Session[]
  sentInvitations Invitation[] @relation("SentInvitations")
  leads           Lead[]       @relation("AssignedLeads")
  deals           Deal[]       @relation("AssignedDeals")
  activities      Activity[]
  tasks           Task[]       @relation("AssignedTasks")
  auditLogs       AuditLog[]

  @@index([workspaceId])
}

model Session {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  userId       String
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  workspaceId String
  invitedById String
  role        String    @default("SALES_REP")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  action      String   // TEAM_INVITE, ROLE_CHANGE, USER_SUSPEND, USER_REACTIVATE, USER_REMOVE, SECURITY_POLICY_UPDATE, PASSWORD_CHANGE, SESSION_REVOKE, etc.
  entityType  String   // User, Invitation, Workspace, Lead, Deal, Session
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType])
}

model Company {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  domain      String?
  industry    String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  deals     Deal[]
  projects  Project[]
  invoices  Invoice[]
  proposals Proposal[]

  @@index([workspaceId])
}

model Contact {
  id          String   @id @default(uuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String
  email       String
  phone       String?
  title       String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals     Deal[]

  @@index([workspaceId])
  @@index([companyId])
}

model Lead {
  id           String   @id @default(uuid())
  workspaceId  String
  assignedToId String?
  firstName    String
  lastName     String
  email        String
  phone        String?
  companyName  String?
  status       String   @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED
  leadScore    Int      @default(0)
  aiSummary    String?
  source       String   @default("Website Inbound")
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities     Activity[]
  tasks          Task[]
  aiAnalyses     LeadAiAnalysis[]
  outreachEmails OutreachEmail[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([assignedToId])
}

model Deal {
  id                String    @id @default(uuid())
  workspaceId       String
  pipelineId        String?
  stageId           String?
  contactId         String?
  companyId         String?
  assignedToId      String?
  title             String
  value             Float     @default(0.0)
  stage             String    @default("DISCOVERY") // DISCOVERY, PROPOSAL, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  lossReason        String?
  expectedCloseDate DateTime?
  isSample          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline      Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("AssignedDeals", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities    Activity[]
  tasks         Task[]

  @@index([workspaceId])
  @@index([workspaceId, stage])
  @@index([workspaceId, createdAt])
  @@index([pipelineId])
  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([assignedToId])
}

model Activity {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  leadId      String?
  dealId      String?
  type        String // NOTE, CALL, EMAIL, MEETING, STAGE_CHANGE
  content     String
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([leadId])
  @@index([dealId])
  @@index([userId])
}

model Task {
  id           String   @id @default(uuid())
  workspaceId  String
  assignedToId String
  leadId       String?
  dealId       String?
  title        String
  dueDate      DateTime
  priority     String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status       String   @default("PENDING") // PENDING, COMPLETED
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo User      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([assignedToId])
  @@index([leadId])
  @@index([dealId])
}

model Project {
  id            String    @id @default(uuid())
  workspaceId   String
  companyId     String?
  title         String
  clientName    String?
  status        String    @default("ON TRACK") // ON TRACK, AT RISK, COMPLETED
  statusType    String    @default("success") // success, warning, info
  progress      Int       @default(0)
  budget        Float     @default(0.0)
  dueDate       DateTime?
  nextMilestone String?
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deliverables Deliverable[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([companyId])
}

model Deliverable {
  id            String    @id @default(uuid())
  workspaceId   String
  projectId     String?
  title         String
  fileName      String?
  fileType      String    @default("pdf")
  status        String    @default("PENDING CLIENT REVIEW")
  statusType    String    @default("pending") // pending, approved, revisions
  version       String    @default("v1.0")
  clientContact String?
  dueDate       DateTime?
  sentDate      DateTime  @default(now())
  accentColor   String    @default("#ffb95f")
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
}

model Invoice {
  id          String   @id @default(uuid())
  workspaceId String
  companyId   String?
  number      String
  client      String
  amount      Float    @default(0.0)
  status      String   @default("PENDING") // PAID, PENDING, OVERDUE
  issuedDate  DateTime @default(now())
  dueDate     DateTime
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([companyId])
}

model Proposal {
  id            String   @id @default(uuid())
  workspaceId   String
  companyId     String?
  leadId        String?
  title         String
  client        String
  value         Float    @default(0.0)
  status        String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  summary       String?
  scopeOfWork   Json?    // Array of { phase: string, duration: string, description: string, deliverables: string[] }
  deliverables  Json?    // Array of strings
  pricingItems  Json?    // Array of { item: string, description: string, price: number }
  paymentTerms  String?
  preparedBy    String?
  acceptedBy    String?
  acceptedTitle String?
  date          DateTime @default(now())
  isSample      Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([companyId])
  @@index([leadId])
}

model FileRecord {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  type        String // PDF, IMAGE, SPREADSHEET, ARCHIVE, DOC
  size        String
  category    String // Contract, Proposal, Deliverable, Brand Asset
  client      String
  project     String?
  uploadedBy  String
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model LeadAiAnalysis {
  id                  String   @id @default(uuid())
  workspaceId         String
  leadId              String
  score               Int      @default(0)
  qualification       String   @default("warm") // hot, warm, cold
  companySummary      String
  likelyPainPoints    Json?    // string[] of identified operational / digital pain points
  recommendedServices Json?    // string[] of agency offerings best suited
  recommendedPitch    String
  reasoning           String
  confidence          Int      @default(85)
  provider            String   @default("system")
  model               String   @default("default")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, createdAt])
}

model OutreachEmail {
  id                    String    @id @default(uuid())
  workspaceId           String
  leadId                String
  subject               String
  body                  String
  callToAction          String?
  recommendedService    String?
  personalizationPoints Json?     // string[]
  status                String    @default("DRAFT") // DRAFT, APPROVED, SENT, FAILED
  tone                  String    @default("professional") // professional, conversational, direct
  generatedAt           DateTime  @default(now())
  approvedAt            DateTime?
  sentAt                DateTime?
  failureReason         String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Pipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId])
}

model PipelineStage {
  id             String   @id @default(uuid())
  workspaceId    String
  pipelineId     String
  name           String   // e.g. "Discovery", "Proposal Sent", "Negotiation", "Closed Won", "Closed Lost"
  key            String   // e.g. "DISCOVERY", "PROPOSAL", "NEGOTIATION", "CLOSED_WON", "CLOSED_LOST", etc.
  probability    Int      @default(50) // 0 to 100
  color          String   @default("#8b5cf6")
  order          Int      @default(0)
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  requiredFields Json?    // string[] e.g. ["value", "expectedCloseDate"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([order])
}

model CustomField {
  id          String   @id @default(uuid())
  workspaceId String
  entityType  String   // "LEAD" | "CONTACT" | "COMPANY" | "DEAL"
  name        String   // e.g. "Budget Range", "Tech Stack"
  key         String   // e.g. "budget_range", "tech_stack"
  fieldType   String   // "TEXT" | "LONG_TEXT" | "NUMBER" | "CURRENCY" | "DATE" | "DROPDOWN" | "MULTI_SELECT" | "CHECKBOX" | "URL"
  options     Json?    // For DROPDOWN and MULTI_SELECT: string[]
  placeholder String?
  description String?
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId])
  @@index([entityType])
}

model CustomFieldValue {
  id            String    @id @default(uuid())
  workspaceId   String
  customFieldId String
  recordId      String    // ID of Lead, Contact, Company, or Deal
  textValue     String?
  numberValue   Float?
  dateValue     DateTime?
  booleanValue  Boolean?
  jsonValue     Json?     // For MULTI_SELECT: string[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, recordId])
  @@index([workspaceId])
  @@index([recordId])
}


