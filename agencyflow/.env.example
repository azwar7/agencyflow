# PostgreSQL Database Connection String (e.g. Neon, Supabase, AWS RDS, self-hosted)
# For pooled connections (Serverless / Next.js / Edge):
DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/agencyflow?sslmode=require&pgbouncer=true"

# Optional: Direct unpooled connection URL (Used for running migrations with Prisma Migrate)
DIRECT_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/agencyflow?sslmode=require"

# Distributed Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://sample-redis-cluster.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample-upstash-rest-token"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-agencyflow-2026"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (Optional - Defaults to 'mock' if unconfigured)
AI_PROVIDER="mock" # mock, openai, anthropic, gemini, huggingface
AI_FALLBACK_PROVIDER="mock"

# External AI Provider API Keys (Server-Side Only)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
HUGGINGFACE_API_KEY=""
